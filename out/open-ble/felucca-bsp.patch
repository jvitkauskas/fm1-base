     fl_wren();
     if (!(fl_rdsr(0x05) & 2u)) rc = -3;
     else {
+#if FM1B_BLE_OPEN
+        uint32_t issued=T4_CNT;
+#endif
         fl_cs(0); fl_tx(0x02); fl_addr(off);
         for (i = 0; i < n; i++) fl_tx(src[i]);
         fl_cs(1);
         fl_inval(off, n);
-        rc = fl_wait_ready(10000u, took_us);      /* generic NOR max 3 ms */
+#if FM1B_BLE_OPEN
+        rc = fl_wait_issued(issued,10000u,50000u,took_us);
