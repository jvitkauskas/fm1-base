diff --git a/docs/BLE-R5.md b/docs/BLE-R5.md
new file mode 100644
index 0000000..acae7c2
--- /dev/null
+++ b/docs/BLE-R5.md
@@ -0,0 +1,28 @@
+<!-- SPDX-License-Identifier: MIT -->
+# Round 5: r8 resolving-list capacity
+
+Uncommitted above `88d426f` on `ble-controller`. The shared controller now has
+**N_RL=10**. It keeps R4's resumable one-entry / at most one AES block per
+resolution item, before connection-event formatting. Reset clears the larger
+list in 128-byte executor slices; a full synchronous clear would exceed the
+existing pessimistic Reset test's 70-us target. Other controller timing,
+encryption, MIC journal and host security policy are unchanged.
+
+This deployment keeps **N_BOND=2** in its original sector journal, explicitly
+allowed by r8 04 section 7 item 5. It does not receive fm1-base's compact A/B
+store, persistent eight-peer LRU, or R3/R4 Apple host changes.
+
+ASan/UBSan: S1, S2, S3, S3.1 and the 10-million-event MIC suite. Logs are
+`out/ble-r5-{s1,s2,s3,s31,mic}-tests.log`. H-22/H-23 now fill all ten entries,
+then test overflow, duplicate identity/IRK and absent entries. Full resolution
+checks miss and last-entry match: 9 blocks with a local zero-IRK entry,
+10 without it, across 10 items, with no item
+performing more than one block, event deferred, modeled maximum 1260 ticks
+(52.5 us) with a deliberately pessimistic 52-us/block cost. Actual HAL's whole
+AES transaction has a shared 26-us deadline; the model is not a device timing
+measurement. The R4 355-tick measured resolution maximum already applied to
+one-entry work: nine such items batched could take 3195 ticks (133.1 us).
+
+The patch is exported by the fm1-base deliverable at
+`out/open-ble/R5-felucca.patch`; no devices or bench hosts were contacted, and
+no flashing, commits or pushes were performed.
diff --git a/docs/BLE-R6.md b/docs/BLE-R6.md
new file mode 100644
index 0000000..0d8d512
--- /dev/null
+++ b/docs/BLE-R6.md
@@ -0,0 +1,37 @@
+# R6 investigation and diagnostics
+
+The MIC failure with central LE Ping is **not reproduced or fixed**. Do not
+promote the zero-failure simulation into a claim about silicon reliability.
+The fm1-base deliverable `out/open-ble/RESULTS-R6.md` describes the path audit,
+model assumptions, evidence gaps and proposed r9 probes in full.
+
+Both implementations retain the existing advertised LE Encryption feature
+only. Unknown ping requests still receive LL_UNKNOWN_RSP. R5's resolving-list
+capacity remains ten; this Felucca host's bond journal remains at two peers.
+
+Diagnostics add a 16-active-event, 6-row-per-event ring in Felucca (fm1-base
+uses 32 events and 64 rows). RX includes empties,
+duplicates, CRC outcomes, slot/header/status and the counter actually used by
+CCM. TX rows are prepare/load/ACK and descriptor snapshots, with logical buffer
+id, assigned counter and raw slot control/toggle. The first local 0x3D or 0x08
+freezes it through reconnect and HCI Reset until power-off. Silent closes do
+not erase the exchanges before a supervision timeout. The CDC BLE status
+formatter prints it, with no payload or key material.
+
+The documented hardware interface cannot supply a per-air-TX stream, actual TX
+NESN or a reliable new/repeat classification. These fields are explicitly
+unknown; descriptor headers in empty slots can be stale. Full-slot refused
+receptions have no descriptor. Per-event overflow is counted. This partially
+addresses the requested diagnostics; it does not claim unobservable packets.
+
+The independent central now uses its own ARQ and counters, a separate TinyCrypt
+AES-based CCM oracle, an authenticated-payload ping timer, ATT writes, CRC errors,
+packet/ACK loss and delayed slot service. It checks both directions and exact
+ATT delivery. `tests/run_ble_s3_tests.py --mic-stress` runs 10 M ping-model events
+(5 M at 15 ms, 5 M at 30 ms), then the inherited 10 M-event stress and directed
+corruption, DMA, encryption transition, ring-freeze and formatter tests. Logs:
+`out/ble-r6-regression-final-tests.log` and
+`out/ble-r6-mic-small-final-tests.log`. The final S3.1 target build also passes
+(`out/ble-r6-build-final.log`): 8,332 bytes of pool headroom remain; the 8,192-byte
+gate was retained. CDC readout uses a 160-byte stack event snapshot. No physical device was accessed and no
+commit was created. Hardware acceptance still starts with the owner ping test.
diff --git a/firmware/ble/ble_radio_diag.inc b/firmware/ble/ble_radio_diag.inc
new file mode 100644
index 0000000..5f4a9b8
--- /dev/null
+++ b/firmware/ble/ble_radio_diag.inc
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: MIT */
+/* R6: metadata only. Included inside ble_security.inc's diagnostics guard.
+ * Writers run with LL exclusion. Keep the first failure until power-off;
+ * session/security Reset must never clear this evidence. */
+static struct {
+    ble_radio_event_t events[BLE_RADIO_EVENTS];
+    uint32_t serial;
+    uint8_t frozen,reason;
+} radio_diag __attribute__((section(".pool.ble")));
+void ble_radio_event(uint16_t event,int closed)
+{
+    ble_radio_event_t *e=&radio_diag.events[radio_diag.serial%BLE_RADIO_EVENTS];
+    if(radio_diag.frozen) return;
+    /* Silent supervision-wait events must not evict the final exchange.
+     * Only events with descriptor activity enter the ring. */
+    if(closed && (!radio_diag.serial || e->epoch!=ble_link.epoch || e->event!=event)) return;
+    if(!radio_diag.serial || e->epoch!=ble_link.epoch || e->event!=event) {
+        uint32_t serial=++radio_diag.serial;
+        e=&radio_diag.events[serial%BLE_RADIO_EVENTS];
+        e->serial=serial; e->epoch=ble_link.epoch; e->event=event;
+        e->count=e->overflow=0; e->closed=0;
+    }
+    if(closed) e->closed=1;
+}
+static uint64_t radio_add(uint8_t kind,uint16_t event,uint16_t header,uint16_t status,
+                          uint8_t slot,uint8_t id,uint8_t flags,uint8_t decision,uint64_t counter)
+{
+    ble_radio_event_t *e; ble_radio_row_t *r; unsigned index;
+    if(radio_diag.frozen) return 0;
+    ble_radio_event(event,0); e=&radio_diag.events[radio_diag.serial%BLE_RADIO_EVENTS];
+    if(e->count==BLE_RADIO_ROWS) { if(e->overflow!=65535u) e->overflow++; return 0; }
+    index=e->count++; r=&e->row[index];
+    r->counter=counter; r->ticks=ble_port_ticks(); r->header=header; r->status=status;
+    r->kind=kind; r->slot=slot; r->id=id; r->decision=decision; r->flags=flags;
+    return (uint64_t)e->serial*BLE_RADIO_ROWS+index;
+}
+uint64_t ble_radio_rx(uint16_t event,uint16_t status,uint16_t header,uint8_t slot,uint8_t flags)
+{
+    unsigned cls=ble_rx_class(status,(uint8_t)(header>>8));
+    uint8_t decision=cls==0 ? BLE_RADIO_ACCEPT : cls==1 ? BLE_RADIO_CRC :
+        cls==2 ? BLE_RADIO_DUPLICATE : BLE_RADIO_OTHER;
+    return radio_add(BLE_RADIO_RX,event,header,status,slot,255,flags,decision,BLE_RADIO_NO_COUNTER);
+}
+static void radio_auth(uint64_t id,uint64_t counter,int ok)
+{
+    uint32_t serial=(uint32_t)(id/BLE_RADIO_ROWS);
+    ble_radio_event_t *e=&radio_diag.events[serial%BLE_RADIO_EVENTS];
+    if(radio_diag.frozen || !id || e->serial!=serial || id%BLE_RADIO_ROWS>=e->count) return;
+    ble_radio_row_t *r=&e->row[id%BLE_RADIO_ROWS];
+    r->counter=counter; r->decision=ok ? BLE_RADIO_AUTH_OK : BLE_RADIO_AUTH_BAD;
+}
+void ble_radio_tx(uint8_t kind,uint16_t event,unsigned slot,int id,uint16_t header,uint16_t status)
+{
+    uint64_t counter=BLE_RADIO_NO_COUNTER;
+    if(kind!=BLE_RADIO_PREP && id>=0 && (unsigned)id<BLE_TX_COUNT) counter=queues.tx[id].radio_counter;
+    /* Descriptor TX SN/MD are bits 2/3; NESN is not exposed here. Preserve
+     * the raw word, rather than manufacturing an on-air header. */
+    (void)radio_add(kind,event,header,status,(uint8_t)slot,(uint8_t)(id<0 ? 255 : id),0,0,counter);
+}
+void ble_radio_freeze(uint8_t reason)
+{
+    if(radio_diag.frozen || (reason!=0x3d && reason!=8)) return;
+    radio_diag.frozen=1; radio_diag.reason=reason;
+}
+void ble_radio_summary(ble_radio_summary_t *out)
+{
+    uint32_t key=ble_port_lock();
+    out->last=radio_diag.serial;
+    out->first=out->last>=BLE_RADIO_EVENTS ? out->last-BLE_RADIO_EVENTS+1u : out->last ? 1u : 0u;
+    out->frozen=radio_diag.frozen; out->reason=radio_diag.reason;
+    ble_port_unlock(key);
+}
+int ble_radio_read(uint32_t serial,ble_radio_event_t *out)
+{
+    uint32_t key=ble_port_lock();
+    const ble_radio_event_t *e=&radio_diag.events[serial%BLE_RADIO_EVENTS];
+    int valid=serial && e->serial==serial;
+    /* Only copy occupied rows. Avoid a multi-kilobyte critical section for
+     * the ordinary one-exchange event. */
+    if(valid) {
+        out->serial=e->serial; out->epoch=e->epoch; out->event=e->event;
+        out->count=e->count; out->overflow=e->overflow; out->closed=e->closed;
+        memcpy(out->row,e->row,e->count*sizeof e->row[0]);
+    }
+    ble_port_unlock(key); return valid;
+}
diff --git a/firmware/ble/ble_radio_dump.inc b/firmware/ble/ble_radio_dump.inc
new file mode 100644
index 0000000..b256aec
--- /dev/null
+++ b/firmware/ble/ble_radio_dump.inc
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: MIT */
+/* Shared USB/CDC formatter. Define BRD_PUTS, BRD_DEC and BRD_HEX. */
+static void ble_radio_dump(void)
+{
+    ble_radio_summary_t s;
+    /* Main-context scratch avoids a large stack frame and long IRQ-off
+     * sections. Rows contain metadata only. Read a bounded event at a time. */
+#ifdef BRD_STACK_EVENT
+    ble_radio_event_t e; /* Small Felucca profile: 160 bytes. */
+#else
+    static ble_radio_event_t e __attribute__((section(".pool.ble")));
+#endif
+    ble_radio_summary(&s);
+    BRD_PUTS("radio_frozen "); BRD_DEC(s.frozen);
+    BRD_PUTS(" reason "); BRD_HEX(s.reason,2);
+    BRD_PUTS(" events "); BRD_DEC(s.first ? (int32_t)(s.last-s.first+1u) : 0);
+    BRD_PUTS("\nradio_tx_source descriptor_only nesn_unknown air_new_repeat_unknown\n");
+    if(!s.first) return;
+    for(uint32_t serial=s.first;serial<=s.last;serial++) {
+        if(!ble_radio_read(serial,&e)) continue;
+        BRD_PUTS("radio_event serial "); BRD_DEC((int32_t)e.serial);
+        BRD_PUTS(" epoch "); BRD_DEC((int32_t)e.epoch);
+        BRD_PUTS(" event "); BRD_DEC(e.event);
+        BRD_PUTS(" closed "); BRD_DEC(e.closed);
+        BRD_PUTS(" rows "); BRD_DEC(e.count);
+        BRD_PUTS(" overflow "); BRD_DEC(e.overflow); BRD_PUTS("\n");
+        for(unsigned j=0;j<e.count;j++) {
+            const ble_radio_row_t *r=&e.row[j]; int rx=r->kind==BLE_RADIO_RX;
+            BRD_PUTS("radio "); BRD_DEC((int32_t)e.serial); BRD_PUTS("/"); BRD_DEC((int32_t)j);
+            BRD_PUTS(r->kind==BLE_RADIO_RX ? " rx" : r->kind==BLE_RADIO_LOAD ? " load" : r->kind==BLE_RADIO_ACK ? " ack" : r->kind==BLE_RADIO_PREP ? " prep" : " tx_state");
+            BRD_PUTS(" t "); BRD_HEX(r->ticks,8);
+            BRD_PUTS(" slot "); BRD_DEC(r->slot); BRD_PUTS(" id "); BRD_DEC(r->id);
+            BRD_PUTS(" sn "); BRD_DEC((r->header>>(rx ? 3 : 2))&1u);
+            BRD_PUTS(" nesn "); if(rx) BRD_DEC((r->header>>2)&1u); else BRD_PUTS("?");
+            BRD_PUTS(" md "); BRD_DEC((r->header>>(rx ? 4 : 3))&1u);
+            BRD_PUTS(" llid "); BRD_DEC(r->header&3u);
+            BRD_PUTS(" len "); BRD_DEC(r->header>>8);
+            BRD_PUTS(" raw "); BRD_HEX(r->status,4);
+            BRD_PUTS(" flags "); BRD_HEX(r->flags,2);
+            BRD_PUTS(" decision "); BRD_DEC(r->decision);
+            BRD_PUTS(" ctr ");
+            if(r->counter==BLE_RADIO_NO_COUNTER) BRD_PUTS("none");
+            else { BRD_HEX((uint32_t)(r->counter>>32),2); BRD_HEX((uint32_t)r->counter,8); }
+            BRD_PUTS("\n");
+        }
+    }
+}
+#undef BRD_STACK_EVENT
+#undef BRD_PUTS
+#undef BRD_DEC
+#undef BRD_HEX
diff --git a/tests/ble_central_ccm.inc b/tests/ble_central_ccm.inc
new file mode 100644
index 0000000..d466aa4
--- /dev/null
+++ b/tests/ble_central_ccm.inc
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: MIT */
+/* Test-only CCM oracle using public TinyCrypt AES directly. It does not call
+ * the controller CCM routine, AES port, security state, or counter helpers. */
+#include "tinycrypt/aes.h"
+static int central_ccm(uint64_t count,int direction,uint8_t llid,uint8_t *p,unsigned length,int decrypt)
+{
+    struct tc_aes_key_sched_struct aes;
+    uint8_t nonce[13],b[16]={0},mac[16]={0},a[16]={1},stream[16],text[27];
+    if(!length || length>27 || count>>39) return 0;
+    assert(tc_aes128_set_encrypt_key(&aes,sk));
+    for(unsigned i=0;i<5;i++) nonce[i]=(uint8_t)(count>>(8*i));
+    nonce[4]|=(uint8_t)(direction ? 0x80u : 0); memcpy(nonce+5,iv,8);
+    b[0]=0x49; memcpy(b+1,nonce,13); b[15]=(uint8_t)length;
+    assert(tc_aes_encrypt(mac,b,&aes));
+    memset(b,0,16); b[1]=1; b[2]=llid&3u;
+    for(unsigned i=0;i<16;i++) b[i]^=mac[i];
+    assert(tc_aes_encrypt(mac,b,&aes));
+    memcpy(a+1,nonce,13);
+    for(unsigned off=0;off<length;off+=16) {
+        a[15]=(uint8_t)(1+off/16); assert(tc_aes_encrypt(stream,a,&aes));
+        memset(b,0,16);
+        for(unsigned j=0;j<16 && off+j<length;j++) {
+            text[off+j]=decrypt ? p[off+j]^stream[j] : p[off+j]; b[j]=text[off+j];
+            if(!decrypt) p[off+j]^=stream[j];
+        }
+        for(unsigned j=0;j<16;j++) b[j]^=mac[j];
+        assert(tc_aes_encrypt(mac,b,&aes));
+    }
+    a[15]=0; assert(tc_aes_encrypt(stream,a,&aes));
+    uint8_t diff=0;
+    for(unsigned i=0;i<4;i++) {
+        uint8_t tag=mac[i]^stream[i];
+        if(decrypt) diff|=tag^p[length+i]; else p[length+i]=tag;
+    }
+    if(decrypt && !diff) memcpy(p,text,length);
+    return !diff;
+}
+static void central_ccm_test(void)
+{
+    begin();
+    for(unsigned direction=0;direction<2;direction++) for(unsigned length=1;length<=27;length++) {
+        uint8_t original[31],air[31]; uint64_t count=((uint64_t)1<<38)+length;
+        for(unsigned j=0;j<length;j++) original[j]=(uint8_t)(length+j);
+        memcpy(air,original,length); assert(central_ccm(count,(int)direction,3,air,length,0));
+        assert(ble_ccm(sk,iv,count,(int)direction,3,air,(uint8_t)length,1));
+        assert(!memcmp(air,original,length));
+        memcpy(air,original,length); assert(ble_ccm(sk,iv,count,(int)direction,3,air,(uint8_t)length,0));
+        uint8_t damaged[31]; memcpy(damaged,air,length+4); damaged[length+2]^=1;
+        assert(!central_ccm(count,(int)direction,3,damaged,length,1));
+        assert(central_ccm(count,(int)direction,3,air,length,1)); assert(!memcmp(air,original,length));
+    }
+    puts("independent central CCM: both directions, lengths 1..27, high counters, corrupted tags rejected: PASS");
+}
diff --git a/tests/ble_ping_stress.inc b/tests/ble_ping_stress.inc
new file mode 100644
index 0000000..af4033e
--- /dev/null
+++ b/tests/ble_ping_stress.inc
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: MIT */
+/* Core central, independent counters/ARQ, with a 100 ms authenticated
+ * payload timer. No feature-gating of ping (Vol 6 B 5.1.8). */
+static void ping_stress(uint32_t events,uint16_t interval)
+{
+    start_interval=interval; uint32_t anchor=begin(); start_interval=12;
+    assert(!oc); ow=orr=0;
+    uint8_t csn=sn,crx=sim_core_start(sn),pending=0,air[31],plain[27];
+    uint8_t length=0,llid=1,last_rx[31],last_length=0,last_llid=0;
+    uint64_t ctx=next_counter,prx=1;
+    uint32_t last_auth=0,pings=0,responses=0,writes=0,rx_repeat=0,tx_repeat=0,crc_count=0;
+    uint32_t timer=0,delay=0;
+    int ping_active=0;
+    for(uint32_t e=0;e<events;e++) {
+        uint32_t now=e*(interval*5u/4u);
+        unsigned burst=(random32()%19u)==0 ? 2u+random32()%4u : 1u;
+        for(unsigned j=0;j<burst;j++) {
+            if(!pending) {
+                length=0; llid=1;
+                if(!ping_active && (uint32_t)(now-last_auth)>=75u) {
+                    plain[0]=18; length=1; llid=3; ping_active=1; pings++; timer=now;
+                } else if((random32()%13u)==0) {
+                    /* L2CAP/ATT Write Command carrying a BLE MIDI note. */
+                    const uint8_t write[]={8,0,4,0,0x52,0x10,0,0x80,0x80,0x90,60,100};
+                    length=sizeof write; memcpy(plain,write,length); llid=2; writes++;
+                }
+                if(length) {
+                    memcpy(air,plain,length);
+                    assert(central_ccm(ctx++,1,llid,air,length,0)); length+=4;
+                }
+                pending=1;
+            } else tx_repeat++;
+            uint16_t ch=(uint16_t)((length<<8)|llid|(csn<<3)|(crx<<2)|((j+1<burst) ? 16u : 0));
+            sim_ticks=anchor+(80u+8u*length+j*708u)*24u;
+            unsigned roll=random32(); int crc=(roll%97u)!=0;
+            if(!crc) crc_count++;
+            int accepted=sim_core_receive(ch,air,(uint16_t)e,crc);
+            if(accepted && llid==2 && length) {
+                assert(oc<128); oracle[ow].n=(uint8_t)(length-4u);
+                memcpy(oracle[ow].p,plain,length-4u); ow=(ow+1u)%128u; oc++;
+            }
+            if(!delay && (random32()%4u)) sim_radio_service(0);
+            uint16_t ph; uint8_t p[31]; sim_core_transmit(&ph,p);
+            if(random32()%41u && random32()%97u) {
+                unsigned n=ph>>8;
+                if(((ph>>3)&1u)==crx) {
+                    crx^=1;
+                    if(n) {
+                        uint8_t decrypted[31]; memcpy(decrypted,p,n);
+                        if(n<5 || !central_ccm(prx,0,(uint8_t)(ph&3u),decrypted,n-4u,1)) {
+                            printf("PING CENTRAL MIC event=%u pings=%u responses=%u expected_counter=%" PRIu64 " pending_empty_loads=%u\n",e,pings,responses,prx,sim_core_empty_pending_loads);
+                            fflush(stdout); abort();
+                        }
+                        prx++; last_auth=now;
+                        if((ph&3u)==3 && n==6 && decrypted[0]==7 && decrypted[1]==18) {
+                            assert(ping_active); ping_active=0; responses++;
+                        }
+                    }
+                    last_length=(uint8_t)n; last_llid=(uint8_t)(ph&3u); memcpy(last_rx,p,n);
+                } else {
+                    rx_repeat++;
+                    assert(n==last_length && (ph&3u)==last_llid && !memcmp(last_rx,p,n));
+                }
+                if(((ph>>2)&1u)!=csn) { csn^=1; pending=0; }
+            }
+            if(!delay) { sim_radio_service(0); drain(); }
+            if(!(ph&16u) && !(ch&16u)) break;
+        }
+        sim_ticks=anchor+6000u*24u;
+        if(!delay) { sim_radio_service(1); drain(); if(random32()%127u==0) delay=1u+random32()%4u; }
+        else delay--;
+        ble_ll_event((uint16_t)e,sim_ticks); ble_link.rx_seen=ble_link.valid_seen=0;
+        assert(ble_link.state==BLE_LINK_UP);
+        assert(!ping_active || now-timer<1000u);
+        anchor+=(uint32_t)interval*30000u;
+        if((e+1u)%1000000u==0) {
+            printf("ping interval=%u events=%u requests=%u replies=%u writes=%u central_repeats=%u peripheral_repeats=%u crc=%u empty_pending_loads=%u zero MIC failures\n",
+                   interval,e+1,pings,responses,writes,tx_repeat,rx_repeat,crc_count,sim_core_empty_pending_loads); fflush(stdout);
+        }
+    }
+    ble_security_diag_t d; ble_security_get_diag(&d); assert(!d.mic_failures);
+    sim_radio_service(1); drain(); assert(!oc);
+    printf("ping final interval=%u events=%u requests=%u replies=%u writes=%u central_repeats=%u peripheral_repeats=%u crc=%u empty_pending_loads=%u: PASS\n",
+           interval,events,pings,responses,writes,tx_repeat,rx_repeat,crc_count,sim_core_empty_pending_loads);
+    assert(pings>100 && responses+1u>=pings && writes && rx_repeat && tx_repeat && crc_count);
+}
diff --git a/tests/ble_radio_trace_test.inc b/tests/ble_radio_trace_test.inc
new file mode 100644
index 0000000..f9d9904
--- /dev/null
+++ b/tests/ble_radio_trace_test.inc
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: MIT */
+static void radio_trace_test(void)
+{
+    begin();
+    for(unsigned e=1;e<=40;e++) {
+        sim_ticks+=15u*24000u;
+        assert(sim_radio_receive(1,(uint16_t)(1u|(sn<<3)),0,(uint16_t)e)); sn^=1;
+        sim_radio_service(0); work(); ble_ll_event((uint16_t)e,sim_ticks);
+    }
+    direct((uint8_t[]){18},1,3,41,1);
+    int reply=opcode(7); assert(reply>=0); sim_ack((unsigned)reply);
+    uint8_t ignored[5]={0};
+    assert(sim_radio_receive(9,(uint16_t)(0x503u|((sn^1u)<<3)),ignored,42));
+    assert(sim_radio_receive(13,0x0513,ignored,43)); sim_radio_service(0); work();
+    uint8_t bad[5]={18}; uint64_t counter=next_counter++;
+    assert(central_ccm(counter,1,3,bad,1,0)); bad[4]^=1;
+    assert(sim_radio_receive(1,(uint16_t)(0x503u|(sn<<3)),bad,44));
+    sim_radio_service(0); work(); assert(ble_link.reason==0x3d);
+    ble_radio_summary_t summary; ble_radio_summary(&summary);
+    assert(summary.frozen && summary.reason==0x3d && summary.last-summary.first+1u==BLE_RADIO_EVENTS);
+    static ble_radio_event_t event;
+    unsigned empty=0,repeat=0,crc=0,auth_bad=0,ack=0,load=0;
+    for(uint32_t serial=summary.first;serial<=summary.last;serial++) {
+        assert(ble_radio_read(serial,&event)); assert(!event.overflow);
+        for(unsigned i=0;i<event.count;i++) {
+            const ble_radio_row_t *r=&event.row[i];
+            if(r->kind==BLE_RADIO_ACK) { ack++; assert(r->counter!=BLE_RADIO_NO_COUNTER); }
+            if(r->kind==BLE_RADIO_LOAD) { load++; assert(r->counter!=BLE_RADIO_NO_COUNTER); }
+            if(r->kind!=BLE_RADIO_RX) continue;
+            if(!(r->header>>8)) { empty++; assert(r->counter==BLE_RADIO_NO_COUNTER); }
+            if(r->decision==BLE_RADIO_DUPLICATE) { repeat++; assert(r->counter==BLE_RADIO_NO_COUNTER); }
+            if(r->decision==BLE_RADIO_CRC) { crc++; assert(r->counter==BLE_RADIO_NO_COUNTER); }
+            if(r->decision==BLE_RADIO_AUTH_BAD) { auth_bad++; assert(r->counter==counter && r->slot<2); }
+        }
+    }
+    assert(empty>=BLE_RADIO_EVENTS-4u && repeat==1 && crc==1 && auth_bad==1 && ack==1 && load==1);
+    assert(ble_radio_read(summary.last,&event));
+    ble_radio_event_t saved=event;
+    ble_ll_reset(); begin();
+    for(unsigned e=0;e<50;e++) ble_ll_event((uint16_t)e,sim_ticks);
+    assert(ble_radio_read(summary.last,&event) && !memcmp(&saved,&event,sizeof saved));
+    ble_radio_summary_t after; ble_radio_summary(&after); assert(summary.first==after.first && summary.last==after.last && summary.frozen==after.frozen && summary.reason==after.reason);
+    printf("radio ring: %u active events, empty/duplicate/CRC rows, exact auth counter, load/ACK once, frozen through Reset/reconnect: PASS\n",BLE_RADIO_EVENTS);
+}
+
+static void radio_timeout_test(void)
+{
+    begin();
+    for(unsigned e=1;e<=40;e++) {
+        sim_ticks+=15u*24000u;
+        assert(sim_radio_receive(1,(uint16_t)(1u|(sn<<3)),0,(uint16_t)e)); sn^=1;
+        sim_radio_service(0); work(); ble_ll_event((uint16_t)e,sim_ticks);
+    }
+    ble_radio_summary_t before,after; ble_radio_summary(&before);
+    for(unsigned e=41;e<600;e++) ble_radio_event((uint16_t)e,1);
+    ble_ll_close(8); ble_radio_summary(&after);
+    assert(after.frozen && after.reason==8 && after.first==before.first && after.last==before.last);
+    printf("central-side MIC/silent timeout: last %u active events retained across 559 silent closes, frozen reason 08: PASS\n",BLE_RADIO_EVENTS);
+}
